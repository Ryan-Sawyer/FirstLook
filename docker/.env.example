# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_DB=firstlook
POSTGRES_USER=firstlook
POSTGRES_PASSWORD=changeme

# ─────────────────────────────────────────
# Control Server
# ─────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# The publicly accessible URL of your control server
# Used to generate agent install commands
FIRSTLOOK_BASE_URL=http://localhost:8000

# Port to expose the control server on
SERVER_PORT=8000

# ─────────────────────────────────────────
# ITflow Integration (optional)
# ─────────────────────────────────────────
ITFLOW_URL=
ITFLOW_API_KEY=
